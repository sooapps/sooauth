# Server — loaded automatically from repo root .env (no manual export needed)
PORT=8080
SOOAUTH_ENV=development
APP_URL=http://localhost:8080
API_URL=http://localhost:8080
# Production: .sooauth.com so auth.sooauth.com and api.sooauth.com share sessions.
COOKIE_DOMAIN=
# Production: https://auth.sooauth.com
DASHBOARD_ORIGIN=http://localhost:8080

# Email — leave SMTP_URL empty to log messages to stdout (dev).
# With Mailhog: docker compose --profile dev up -d mailhog
# SMTP_URL=smtp://localhost:1025
SMTP_FROM=sooauth@localhost

# Postgres
POSTGRES_USER=sooauth
POSTGRES_PASSWORD=sooauth
POSTGRES_DB=sooauth
POSTGRES_PORT=5433
DATABASE_URL=postgres://sooauth:sooauth@localhost:5433/sooauth?sslmode=disable

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Social login (M6) — optional; can also configure in /admin/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Admin (M9) — comma-separated emails; empty = any signed-in user in dev
# ADMIN_EMAILS=you@example.com

# Branding (M8/M9)
# BRAND_NAME=sooauth
# BRAND_LOGO_URL=
# BRAND_ACCENT=#E8FF3F
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:8080

# MFA (required in production; generate with: openssl rand -base64 32)
# MFA_ENCRYPTION_KEY=

# Production: refuse insecure defaults when SOOAUTH_ENV=production
# AUTO_MIGRATE=true
