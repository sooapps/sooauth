# Coolify → Environment Variables (paste into UI)
# Generate: openssl rand -hex 24

APP_URL=https://auth.sooauth.com

POSTGRES_USER=sooauth
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sooauth

# Migrations run automatically on container start (AUTO_MIGRATE=true in compose)
AUTO_MIGRATE=true

# Email — required for sign-up verify + password reset in production
#
# Recommended (passwords with ? ! @ etc. work as-is):
SMTP_HOST=promail.internetbilisim.net
SMTP_PORT=465
SMTP_USER=info@sooapps.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM=info@sooapps.com
#
# Alternative single URL — special chars in password MUST be URL-encoded:
#   @ → %40   ? → %3F   ! → %21   # → %23
# Example: smtp://info%40sooapps.com:pass%3F%21@promail.internetbilisim.net:465
# SMTP_URL=

# Admin panel: any signed-up account owner gets access automatically.
# ADMIN_EMAILS is deprecated — leave unset for hosted SaaS.

# Billing: set true on self-hosted Coolify to upgrade plans from dashboard without PayTR/Stripe yet.
# BILLING_MANUAL_UPGRADE=true

# Navicat (temporary): docker-compose.coolify.yml exposes postgres on host port 5433.
# Connection: host=VDS_IP port=5433 db=sooauth user=sooauth password=POSTGRES_PASSWORD ssl=disable
# Remove the ports: block from compose after you finish manual SQL.

# WebAuthn / passkeys
WEBAUTHN_RP_ID=sooauth.com
WEBAUTHN_ORIGIN=https://auth.sooauth.com

# TOTP MFA secret encryption (base64-encoded 32-byte key)
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=generate-a-base64-32-byte-key

# Platform social login (customers toggle in dashboard — no keys required per tenant)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Branding (optional — or /admin/ theme)
BRAND_NAME=sooauth
BRAND_ACCENT=#E8FF3F
