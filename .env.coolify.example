# Coolify -> Environment Variables Template
# Generate random passwords with: openssl rand -hex 24

APP_URL=https://auth.yourdomain.com

POSTGRES_USER=sooauth
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sooauth

# Migrations run automatically on container start
AUTO_MIGRATE=true

# Production SMTP Email Delivery (required for email verification & password resets)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@yourdomain.com

# WebAuthn / Passkeys (set to your root domain)
WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_ORIGIN=https://auth.yourdomain.com

# TOTP MFA secret encryption (base64-encoded 32-byte key)
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=generate-a-base64-32-byte-key

# Platform Social Login (Google & GitHub)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Branding
BRAND_NAME=sooauth
BRAND_ACCENT=#E8FF3F
